# Conduck — API keys & tokens for manual testing (template)
# ============================================================================
# Conduck has NO backend — nothing reads this file at build, test, or runtime.
# It exists as a paste-source: copy values into the app's Settings → API Key
# field (per active STT preset) when manually verifying the cloud voice
# providers on a simulator.
#
# Setup:
#   cp .env.example .env       # .env is gitignored — never commit real keys
#   # Fill in real values, then in the app: Settings → pick a preset → paste.
# ============================================================================

# ============================================
# STT Provider Keys (5 cloud providers, user-selectable)
# ============================================
# Preset IDs are LOCKED (the Keychain account suffix depends on them —
# DO NOT RENAME):
#   mistral-voxtral · openai-gpt4o-transcribe · elevenlabs-scribe-v2
#   gemini-3-1-flash-lite · openrouter-stt

# Mistral Voxtral V2 (`voxtral-mini-2602`) — DEFAULT preset
# https://console.mistral.ai/api-keys
# Probe: GET https://api.mistral.ai/v1/models  (free)
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI `gpt-4o-transcribe`
# https://platform.openai.com/api-keys
# Probe: GET https://api.openai.com/v1/models  (free)
OPENAI_API_KEY=sk-your_openai_api_key_here

# ElevenLabs `scribe_v2`
# https://elevenlabs.io/app/settings/api-keys
# Probe: GET https://api.elevenlabs.io/v1/user  (free)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini 3.1 Flash-Lite
# https://aistudio.google.com/apikey
# Probe: GET https://generativelanguage.googleapis.com/v1beta/models  (free)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (hosted voice lane — key is cross-reusable with the OpenRouter
# gateway token via the in-app one-tap reuse)
# https://openrouter.ai/settings/keys
# Probe: GET https://openrouter.ai/api/v1/key  (free)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# ============================================
# QA gateway tokens (optional — QA-mode launch flow only)
# ============================================
# Sourced by the maintainer-side QA harness (docs/qa/qa-mode.md), which
# interpolates them onto the `-ConduckQA…` launch arguments; the app itself
# never reads this file. Point these at YOUR OWN gateway instances.
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here
HERMES_API_SERVER_KEY=your_hermes_api_server_key_here
