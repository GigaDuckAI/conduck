// Conduck build identity — Community defaults.
// To build with a different identity, create Identity-Override.xcconfig beside
// this file (gitignored in the public repo) defining the same CONDUCK_* variables.
CONDUCK_BUNDLE_ID_BASE = com.example.Conduck
CONDUCK_IDENTITY_NAMESPACE = com.example.conduck
CONDUCK_GROUP_ID = group.com.example.conduck
CONDUCK_ICLOUD_CONTAINER_ID = iCloud.com.example.conduck
CONDUCK_ICLOUD_BLOBS_CONTAINER_ID = iCloud.com.example.conduck.blobs
// OAuth callback scheme (RFC 8252 private-use URL scheme) — derived from the
// namespace so an override sets it implicitly and no two builds claim the same
// scheme; must stay a legal scheme: letter first, then letters/digits/./-/+.
CONDUCK_OAUTH_SCHEME = $(CONDUCK_IDENTITY_NAMESPACE)
CONDUCK_DISPLAY_NAME = Conduck Community
CONDUCK_ENTITLEMENTS_VARIANT = Community
// Empty in source builds; official distribution supplies its numeric listing ID.
CONDUCK_APP_STORE_ID =
// Official distribution supplies its registered monthly subscription product.
// Empty Community builds do not offer purchases for someone else's app.
CONDUCK_PRO_MONTHLY_PRODUCT_ID =
CONDUCK_DEVELOPMENT_TEAM =

DEVELOPMENT_TEAM = $(CONDUCK_DEVELOPMENT_TEAM)

// Single source for version numbers (removed from per-target settings)
MARKETING_VERSION = 1.6.4
CURRENT_PROJECT_VERSION = 17

#include? "Identity-Override.xcconfig"
