    "share.work.error.audioRefused" : {
      "comment" : "Non-retryable failure message when a share bound for Work carries a recording",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings can’t be shared into Work. To keep one, open Work and add it with the attachment button."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音无法通过共享添加到工作台。如需保留，请打开工作台，使用附件按钮添加。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden compartir grabaciones con Trabajo. Para conservar una, abre Trabajo y añádela con el botón de adjuntar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音は共有からワークスペースに追加できません。保存するには、ワークスペースを開き、添付ボタンで追加してください。"
          }
        }
      }
    },
    "share.work.error.empty" : {
      "comment" : "Actionable empty Workboard capture failure message",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There’s nothing to add yet. Add a message or include at least one shared item, then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂无可添加的内容。请添加消息或至少包含一个共享项目后重试。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada que añadir. Añade un mensaje o incluye al menos un elemento compartido y vuelve a intentarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加する内容がありません。メッセージを入力するか、共有項目を1つ以上含めて再試行してください。"
          }
        }
      }
    },
    "share.work.error.invalidContent" : {
      "comment" : "Non-retryable failure message when a share breaks the Work capture contract",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Something in this share can’t be saved to Work. Share it a different way, or share fewer items."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
