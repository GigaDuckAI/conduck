    },
    "settings.remoteAgent.tip.imageHistory.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many of the pictures you've already sent get re-sent with each new message, so the AI can still see them. More images means it remembers more, but every turn gets slower and costs more. Older pictures beyond the limit are still referred to by name."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条新消息会重新发送多少张之前的图片，让 AI 仍能看到它们。图片越多，记住的内容越多，但每轮更慢且费用更高。超出限制的旧图片仍以名称引用。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas de las imágenes que ya enviaste se vuelven a enviar con cada mensaje nuevo para que la IA pueda seguir viéndolas. Más imágenes significa que recuerda más, pero cada turno tarda más y cuesta más. Las imágenes anteriores que superen el límite siguen mencionándose por su nombre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIが引き続き画像を見られるように、新しいメッセージごとに過去の画像を何枚再送するかを決めます。枚数を増やすと記憶できる範囲が広がりますが、各ターンは遅くなり料金も増えます。上限より古い画像も名前で参照されます。"
          }
        }
      }
    },
