    "settings.remoteAgent.tip.model.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which AI answers you — the exact name your gateway or provider knows it by, such as “llama3”. Run Test Connection first and Conduck fills in the choices it can see. You can always type a name yourself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "决定哪个 AI 回复你，填写网关或服务商识别的确切名称，例如“llama3”。先运行“测试连接”，Conduck 会列出可见选项。你也可随时自行输入名称。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué IA te responde: el nombre exacto con el que la conoce tu pasarela o proveedor, como “llama3”. Ejecuta primero Probar conexión y Conduck muestra las opciones que puede ver. Siempre puedes escribir un nombre por tu cuenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答するAIを、ゲートウェイやプロバイダーが認識する正確な名前（例：「llama3」）で指定します。まず「接続をテスト」で、確認できた候補が表示されます。名前を直接入力することもできます。"
          }
        }
      }
    },
