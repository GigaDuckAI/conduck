            "value" : "Gateway '%@' is no longer available. This conversation stays readable; clone it to keep going on another gateway."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网关“%@”已不可用。此对话仍可阅读，复制到另一网关即可继续。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
