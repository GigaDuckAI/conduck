    "settings.personalAI.default.unavailable.footer.ipad" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ isn't available on this iPad, so anything that starts a chat from outside the app has nowhere to go. It'll work again on its own if it's waiting on iCloud — or pick a gateway that works here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在此 iPad 不可用，因此从 App 外发起的对话没有可用目标。如果正在等待 iCloud 同步，稍后会自动恢复；你也可以选择此设备可用的网关。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible en este iPad, así que lo que inicie un chat desde fuera de la app no tiene destino. Volverá a funcionar por sí sola si espera a iCloud, o puedes elegir una pasarela que funcione aquí."
          }
