    "thread.outputs.review.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck puts a one-tap download in the chat for the file types an agent usually produces — documents, images, audio, data, code. Anything else stays in the folder until you've had a look."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于智能体通常生成的文件类型，如文稿、图片、音频、数据和代码，Conduck 会在对话中提供一键下载。其他文件留在文件夹中，等待你检查。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck añade al chat una descarga de un toque para los tipos de archivo que suele producir un agente: documentos, imágenes, audio, datos y código. Los demás permanecen en la carpeta hasta que los revises."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが通常作成する文書、画像、音声、データ、コードは、チャットからワンタップでダウンロードできます。それ以外は確認するまでフォルダに残ります。"
          }
        }
      }
    },
    "thread.outputs.review.why.byName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck goes by the file's name, not by what's inside it. So this is about what your agent called the file, not a judgment about the file itself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 根据文件名判断，而非文件内容。这只是对智能体命名的分类，不是对文件本身的评估。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck se guía por el nombre del archivo, no por su contenido. Esto se refiere al nombre que le dio tu agente, no a una evaluación del archivo en sí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduckはファイルの内容ではなく名前で判断します。これはエージェントが付けた名前についての説明で、ファイル自体の評価ではありません。"
          }
        }
      }
    },
