    "settings.remoteAgent.freeLimit.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your free plan includes three active gateways. Upgrade to Pro for unlimited gateways, or manage your free selection. OpenRouter is always available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费方案包含三个启用的网关。升级 Pro 可使用不限数量的网关，或管理免费方案的选择。OpenRouter 始终可用。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan gratuito incluye tres pasarelas activas. Pasa a Pro para tener pasarelas ilimitadas o gestiona tu selección gratuita. OpenRouter siempre está disponible."
          }
        },
        "ja" : {
