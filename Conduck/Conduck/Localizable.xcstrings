    "workdesk.project.delete.remove.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes these materials and their attached notes from Work on your synced devices. Existing conversations and files already sent to gateways remain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从已同步设备的工作台移除这些素材及其附加备注。现有对话和已发送到网关的文件保留。"
          }
