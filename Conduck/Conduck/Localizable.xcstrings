    "settings.remoteAgent.keylessPublic.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a token, anyone who can reach this address can use your AI and its tools. Turn the token back on, or move the gateway onto a private network like Tailscale. If this address is already private (a Tailscale or internal name), you can ignore this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有令牌时，任何能够访问此地址的人都能使用你的 AI 及其工具。请重新开启令牌，或将网关放到 Tailscale 等私有网络中。如果地址已属于私有网络（Tailscale 或内部名称），可忽略此提示。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin token, cualquiera que pueda acceder a esta dirección puede usar tu IA y sus herramientas. Vuelve a activar el token o mueve la pasarela a una red privada como Tailscale. Si esta dirección ya es privada (un nombre de Tailscale o interno), puedes ignorar esto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証トークンがないと、このアドレスに接続できる人は誰でもAIとそのツールを使えます。認証トークンを再び有効にするか、Tailscaleなどの非公開ネットワークにゲートウェイを移してください。アドレスがすでに非公開（Tailscale名や内部名）の場合は、この通知を無視できます。"
          }
        }
      }
    },
    "settings.remoteAgent.keylessPublic.title" : {
