    "settings.remoteAgent.tip.requiresToken.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About Requires a bearer token"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于需要 Bearer 令牌"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de Requiere un token de portador"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Bearer認証トークンを必須にする」について"
          }
        }
      }
    },
    "settings.remoteAgent.tip.requiresToken.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave this on unless your gateway is deliberately set up without a password. Off means Conduck sends no password at all — anyone who can reach the address can use your AI. That's only safe on a private network like Tailscale or your own LAN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非网关刻意设置为无密码，否则请保持开启。关闭后 Conduck 完全不发送密码，任何能访问地址的人都可使用 AI。仅在 Tailscale 或局域网等私有网络中安全。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo activado salvo que tu pasarela esté expresamente configurada sin contraseña. Desactivado significa que Conduck no envía ninguna contraseña: cualquiera que pueda acceder a la dirección puede usar tu IA. Eso solo es seguro en una red privada como Tailscale o tu propia LAN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイを意図的にパスワードなしで設定した場合以外は、有効のままにしてください。無効にするとConduckはパスワードを送らず、アドレスに接続できる人は誰でもAIを使えます。Tailscaleや自分のLANなど、非公開ネットワークでのみ安全です。"
          }
        }
      }
    },
    "settings.remoteAgent.tip.requiresToken.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
