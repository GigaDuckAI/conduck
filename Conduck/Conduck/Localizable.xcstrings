    "thread.outputs.review.installer.trust" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open it only if you asked for it and you know what it sets up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你主动要求此文件，且了解它的设置内容时才打开。"
