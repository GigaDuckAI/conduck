    "settings.remoteAgent.imageHistory.caption.all" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Re-sends every recent image message in full each turn. Most expensive; long image chats may hit size limits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每轮重新完整发送近期所有图片消息。费用最高，较长的图片对话可能达到大小限制。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reenvía completos todos los mensajes recientes con imágenes en cada turno. Es la opción más cara; los chats largos con imágenes pueden alcanzar límites de tamaño."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ターンで最近の画像メッセージをすべて再送します。料金が最も高く、画像の多い長いチャットはサイズ上限に達することがあります。"
          }
        }
      }
    },
