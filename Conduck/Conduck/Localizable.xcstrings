    "settings.voice.access.clearKey.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Speech-to-text and text-to-speech for %@ will stop working until you add a key again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的语音转文字和文字转语音将停止工作，直到你重新添加密钥。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voz a texto y Texto a voz de %@ dejarán de funcionar hasta que añadas otra clave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーを再追加するまで、%@の音声からテキストとテキストから音声は使えなくなります。"
          }
        }
      }
    },
    "settings.voice.access.clearKey.message.active" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Speech-to-text and text-to-speech for %@ will stop working until you add a key again. Conduck switches speech-to-text back to Apple on-device and the reply voice back to the Apple voice, on this device and on your Apple Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的语音转文字和文字转语音将停止工作，直到你重新添加密钥。Conduck 会在此设备和 Apple Watch 上将语音转文字切回 Apple 设备端服务，回复语音切回 Apple 语音。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voz a texto y Texto a voz de %@ dejarán de funcionar hasta que añadas otra clave. Conduck vuelve a usar Apple en el dispositivo para Voz a texto y la voz de Apple para las respuestas, en este dispositivo y en tu Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーを再追加するまで、%@の音声からテキストとテキストから音声は使えなくなります。このデバイスとApple Watchの文字起こしはAppleのデバイス内認識に、返信の音声はAppleの音声に戻ります。"
          }
        }
      }
    },
