    "settings.certTrust.status.automatic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic — this server proves who it is with a certificate this device already trusts. Most servers work this way, and there's nothing to set up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动：服务器使用此设备已信任的证书证明身份。大多数服务器采用此方式，无需设置。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automática: este servidor demuestra su identidad con un certificado en el que este dispositivo ya confía. La mayoría de servidores funcionan así y no hay nada que configurar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動 — このサーバーは、デバイスがすでに信頼する証明書で身元を証明します。ほとんどのサーバーはこの方式で、設定は不要です。"
          }
        }
      }
    },
