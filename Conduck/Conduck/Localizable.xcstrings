    "workdesk.project.delete.shared" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some materials also appear in other projects. Keeping materials preserves those appearances; deleting materials removes them everywhere in Work."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分素材也存在于其他项目。保留素材会保留它们在其他项目中的内容；删除素材会从工作台的所有位置移除。"
          }
        },
        "es" : {
