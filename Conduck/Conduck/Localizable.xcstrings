    "settings.pairing.tailscale.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gateway is on a tailnet. Install the Tailscale app on this device and sign in to the same tailnet, or the connection test will fail."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此网关位于 Tailscale 私有网络（tailnet）中。请在此设备安装 Tailscale App 并登录同一个 tailnet，否则连接测试会失败。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pasarela está en una tailnet. Instala la app Tailscale en este dispositivo e inicia sesión en la misma tailnet o fallará la prueba de conexión."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲートウェイはtailnet上にあります。このデバイスにTailscaleアプリをインストールし、同じtailnetにサインインしないと接続テストは失敗します。"
          }
        }
      }
    },
    "settings.pairing.tailscale.privateRelay" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Already signed in and it still fails? Turn off iCloud Private Relay — Settings › your name › iCloud › Private Relay. It can take over name lookups even while Tailscale says it is connected, so this gateway's address is looked up on the public internet instead of inside your tailnet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已登录但仍失败？请关闭 iCloud 专用代理：“设置”› 你的姓名 ›“iCloud”›“专用代理”。即使 Tailscale 显示已连接，专用代理仍可能接管域名查询，使此网关的地址在公共互联网而非 tailnet 内解析。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya has iniciado sesión y sigue fallando? Desactiva Relay privado de iCloud: Ajustes › tu nombre › iCloud › Relay privado. Puede controlar la resolución de nombres incluso cuando Tailscale indica que está conectado, haciendo que la dirección de esta pasarela se busque en internet en lugar de dentro de tu tailnet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン済みでも失敗しますか？設定 › 自分の名前 › iCloud › プライベートリレーで、iCloudプライベートリレーを無効にしてください。Tailscaleが接続済みと表示していても名前解決を引き受け、ゲートウェイのアドレスをtailnet内ではなく公開インターネットで検索する場合があります。"
          }
        }
      }
    },
