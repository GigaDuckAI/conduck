    "fileTransfer.tip.credential.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About Server password"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于服务器密码"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de Contraseña del servidor"
          }
        },
        "ja" : {
          "stringUnit" : {
