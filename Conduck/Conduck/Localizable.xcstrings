    "diagnostics.connection.defaultGateway.unavailable" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your default gateway isn't available on this device, so new chats and the GigaAction Shortcut won't go anywhere. It'll work again on its own if it's just waiting on iCloud, or you can switch to a gateway that works here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认网关在此设备不可用，因此新对话和 GigaAction 快捷指令无法发送。如果只是等待 iCloud 同步，稍后会自动恢复；你也可以切换到此设备可用的网关。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pasarela predeterminada no está disponible en este dispositivo, así que los chats nuevos y el atajo GigaAction no tendrán destino. Volverá a funcionar por sí sola si solo espera a iCloud, o puedes cambiar a una pasarela que funcione aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトのゲートウェイがこのデバイスで利用できないため、新しいチャットとGigaActionショートカットは送信できません。iCloud同期を待っているだけなら自動的に復旧します。ここで使えるゲートウェイに切り替えることもできます。"
          }
        }
      }
    },
    "diagnostics.connection.defaultGateway.unavailable.named" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is your default for new chats, but it isn't available on this device — so new chats and the GigaAction Shortcut won't go anywhere. It'll work again on its own if it's just waiting on iCloud, or you can switch to one of your %2$lld working gateways."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 是新对话的默认 AI，但在此设备不可用，因此新对话和 GigaAction 快捷指令无法发送。如果只是等待 iCloud 同步，稍后会自动恢复；你也可以切换到 %2$lld 个可用网关中的一个。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es tu opción predeterminada para los chats nuevos, pero no está disponible en este dispositivo, así que los chats nuevos y el atajo GigaAction no tendrán destino. Volverá a funcionar por sí sola si solo espera a iCloud, o puedes cambiar a una de tus %2$lld pasarelas que funcionan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいチャットのデフォルトは%1$@ですが、このデバイスで利用できないため、新しいチャットとGigaActionショートカットは送信できません。iCloud同期を待っているだけなら自動的に復旧します。利用できる%2$lld個のゲートウェイから選ぶこともできます。"
          }
        }
      }
    },
