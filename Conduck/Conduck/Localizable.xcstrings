    "settings.remoteAgent.customHelp.adapter.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you built your own AI and it can't answer web requests yet, it needs a small front door — an adapter — that Conduck can knock on. The AI coding tool you built it with can write that adapter for you: copy the instructions and paste them into that tool."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你构建的 AI 尚无法响应网络请求，它需要一个小型入口，也就是适配器，供 Conduck 连接。构建它的 AI 编程工具可以帮你编写适配器：复制说明并粘贴到该工具中。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si creaste tu propia IA y aún no puede responder a solicitudes web, necesita una pequeña entrada, un adaptador, a la que Conduck pueda llamar. La herramienta de programación con IA que usaste puede escribir ese adaptador por ti: copia las instrucciones y pégalas en esa herramienta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自作のAIがまだWebリクエストに応答できない場合、Conduckが接続できる小さな窓口、アダプターが必要です。AIの作成に使ったコーディングツールがアダプターを書けます。手順をコピーしてそのツールに貼り付けてください。"
          }
        }
      }
    },
