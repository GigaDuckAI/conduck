    "thread.outputs.noFolder.body" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck couldn't confirm a fresh folder on your file server for this message, so it never told the agent where to put files and nothing could come back with the reply. Anything the agent wrote went to its own working folder — if the reply names a file, you can search for it. Check your file server, then send again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 无法为此消息确认文件服务器上的新文件夹，因此没有告知智能体保存位置，回复无法带回文件。智能体写入的内容在它自己的工作文件夹中；如果回复提到文件名，你可以搜索它。请检查文件服务器后重新发送。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck no pudo confirmar una carpeta nueva en tu servidor de archivos para este mensaje, así que no indicó al agente dónde poner los archivos y ninguno pudo volver con la respuesta. Lo que escribiera el agente quedó en su propia carpeta de trabajo: si la respuesta menciona un archivo, puedes buscarlo. Revisa tu servidor de archivos y vuelve a enviar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメッセージ用の新しいフォルダをファイルサーバー上で確認できなかったため、エージェントに保存先を伝えておらず、返信にファイルを追加できませんでした。エージェントが書いたファイルは自身の作業フォルダにあります。返信にファイル名がある場合は検索できます。ファイルサーバーを確認して再送してください。"
          }
        }
      }
    },
