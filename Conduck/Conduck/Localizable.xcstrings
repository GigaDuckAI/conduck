    "remoteAgent.editor.authFailed.hosted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That API key was rejected. Check it in your OpenRouter dashboard, then paste it again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 密钥被拒绝，请在 OpenRouter 控制面板中检查后重新粘贴。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa clave de API fue rechazada. Compruébala en tu panel de OpenRouter y vuelve a pegarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APIキーが拒否されました。OpenRouterのダッシュボードで確認し、もう一度貼り付けてください。"
          }
        }
      }
    },
    "remoteAgent.editor.authFailed.hosted.badShape" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That API key was rejected — and it doesn't look like a complete OpenRouter key (they start with sk-or-). Check the paste and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 密钥被拒绝，且不像完整的 OpenRouter 密钥（应以 sk-or- 开头）。请检查粘贴内容后重试。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa clave de API fue rechazada y no parece una clave completa de OpenRouter (empiezan por sk-or-). Comprueba lo que pegaste y vuelve a intentarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
