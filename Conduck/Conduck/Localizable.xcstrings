    "settings.personalAI.tip.newChats.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new chat on this device continues on the gateway you last used, so you don’t have to pick it again each time. This setting is where the first one starts, and where the Action Button and Shortcuts send when nothing asked you to choose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备的新对话会使用上次使用的网关，无需每次重新选择。此设置决定首次对话使用哪个网关，以及未询问你选择时，操作按钮和快捷指令发送到哪里。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chat nuevo en este dispositivo continúa en la última pasarela que usaste para que no tengas que elegirla cada vez. Este ajuste define dónde empieza el primero y adónde envían el botón de acción y los atajos cuando nada te pidió elegir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの新しいチャットは、最後に使ったゲートウェイで続くため、毎回選ぶ必要はありません。この設定は最初の送信先と、選択を求められなかった場合のアクションボタンやショートカットの送信先を決めます。"
          }
        }
      }
    },
    "settings.personalAI.tip.newChats.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where new chats start"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新对话的起点"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde empiezan los chats nuevos"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいチャットの開始先"
          }
        }
      }
    },
