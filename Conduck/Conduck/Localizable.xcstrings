          }
        }
      }
    },
    "regionCapture.permission.mic.work.body" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Capture to Work saves a spoken note on your desk. To record it, Conduck needs microphone access."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“采集到工作台”会将语音笔记保存到工作台，Conduck 需要麦克风权限来录音。"
          }
        },
        "es" : {
          "stringUnit" : {
