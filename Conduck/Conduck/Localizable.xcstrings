    "settings.pairing.export.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setup code is a reusable password. It contains your gateway token — anyone who scans or photographs it gets full access to this gateway, and to its file server if this code includes one. A photo or copy keeps working until you rotate the token on the gateway. If a device is lost, rotate the gateway token and the file-server password on your server, then re-pair your remaining devices."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设置代码相当于可重复使用的密码。它包含网关令牌，任何扫描或拍摄它的人都可完整访问此网关；如果代码包含文件服务器，也可访问它。照片或副本会一直有效，直到你在网关上更换令牌。如果设备丢失，请在服务器上更换网关令牌和文件服务器密码，再重新配对其余设备。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código de configuración es una contraseña reutilizable. Contiene el token de tu pasarela: cualquiera que lo escanee o fotografíe obtiene acceso completo a esta pasarela y a su servidor de archivos si el código incluye uno. Una foto o copia seguirá funcionando hasta que cambies el token en la pasarela. Si pierdes un dispositivo, cambia el token de la pasarela y la contraseña del servidor de archivos en tu servidor, y vuelve a enlazar los dispositivos que conserves."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定コードは繰り返し使えるパスワードです。ゲートウェイの認証トークンを含むため、スキャンまたは撮影した人は誰でも、このゲートウェイと、コードに含まれていればファイルサーバーにも完全にアクセスできます。写真やコピーはゲートウェイの認証トークンを変更するまで有効です。デバイスを紛失した場合は、サーバーでゲートウェイの認証トークンとファイルサーバーのパスワードを変更し、残りのデバイスを再ペアリングしてください。"
          }
        }
      }
    },
