      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both values belong to the server you run. You're looking for them on that machine, not on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两项都属于你运行的服务器，需要在那台机器上查找，而非此设备。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos valores pertenecen al servidor que gestionas. Debes buscarlos en esa máquina, no en este dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらも運用するサーバーの情報です。このデバイスではなく、そのマシンで確認してください。"
