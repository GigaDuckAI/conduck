      }
    },
    "diagnostics.footer.testEverything" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks saved connections and file servers, plus transcription when set up. File tests upload and remove a small sample. Cloud tests may incur charges. Voice playback is tested separately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查已保存的连接和文件服务器，以及已设置的转写服务。文件测试会上传并删除一个小型示例文件。云端测试可能收费，语音播放需单独测试。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba las conexiones y los servidores de archivos guardados, además de la transcripción si está configurada. Las pruebas de archivos suben y eliminan una pequeña muestra. Las pruebas en la nube pueden generar cargos. La reproducción de voz se prueba por separado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの接続とファイルサーバーを確認し、設定済みなら文字起こしもテストします。ファイルテストでは小さいサンプルをアップロードして削除します。クラウドテストには料金がかかる場合があります。音声再生は別にテストします。"
          }
        }
      }
    },
    "diagnostics.footer.voice" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses your selected providers. Cloud providers may charge for these tests."
          }
        },
