    "stt.error.customCertKeyUnpinnable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your custom STT server's certificate uses a key type Conduck can't fingerprint, so your pinned fingerprint can't be checked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义 STT 服务器证书的密钥类型不支持生成指纹，Conduck 无法核验你固定的指纹。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado de tu servidor de STT personalizado usa un tipo de clave cuya huella Conduck no puede calcular, por lo que no se puede comprobar la huella fijada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムSTTサーバーの証明書の鍵形式にConduckが対応していないため、固定したフィンガープリントを確認できません。"
          }
        }
      }
    },
