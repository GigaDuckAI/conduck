    "conversations.deleteAll.local.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes every conversation from this device. These deletions can sync while turning off is still in progress or if you turn content sync back on. Usage history is cleared across all your devices even while content sync is off. Your Work desk stays untouched. This cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除此设备上的所有对话。关闭同步的过程中，或重新开启内容同步后，删除操作可能同步到其他设备。即使内容同步已关闭，用量历史也会从所有设备清除。工作台内容保留。此操作无法撤销。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todas las conversaciones de este dispositivo. Estas eliminaciones pueden sincronizarse mientras aún se está desactivando la sincronización o si vuelves a activar la sincronización de contenido. El historial de uso se borra en todos tus dispositivos incluso con la sincronización de contenido desactivada. Tu escritorio de Trabajo queda intacto. No se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのすべての会話を削除します。同期を無効にしている途中や、コンテンツ同期を再び有効にした場合、削除も同期されることがあります。利用履歴はコンテンツ同期が無効でもすべてのデバイスから削除されます。ワークスペースは影響を受けません。この操作は取り消せません。"
          }
        }
      }
    },
    "conversations.deleteAll.synced.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes every conversation and its usage records from this device and all your other devices. Your Work desk and everything on it stay untouched. This cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除此设备及所有其他设备上的全部对话和用量记录。工作台及其中的所有内容保留。此操作无法撤销。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todas las conversaciones y sus registros de uso de este dispositivo y de todos los demás. Tu escritorio de Trabajo y todo lo que contiene quedan intactos. No se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての会話と利用記録を、このデバイスとほかのすべてのデバイスから削除します。ワークスペースとその内容は影響を受けません。この操作は取り消せません。"
          }
        }
      }
    },
