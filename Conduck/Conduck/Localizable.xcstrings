    "regionCapture.permission.mic.body" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Region Capture lets you select part of your screen and ask about it by voice. To record your question, Conduck needs microphone access.\n\nYour screenshot and your words are sent only to the AI gateway you configured — nowhere else."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“区域截取”让你选择部分屏幕，并用语音询问相关问题。Conduck 需要麦克风权限来录制问题。\n\n截屏和文字只发送到你配置的 AI 网关，不发送到其他地方。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura de una zona permite seleccionar parte de la pantalla y preguntar sobre ella por voz. Para grabar tu pregunta, Conduck necesita acceso al micrófono.\n\nTu captura y tu texto solo se envían a la pasarela de IA que configuraste, a ningún otro lugar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲取り込みでは、画面の一部を選択して音声で質問できます。質問を録音するには、Conduckのマイクへのアクセスが必要です。\n\nスクリーンショットと言葉は、設定したAIゲートウェイだけに送信されます。"
          }
        }
      }
    },
    "regionCapture.permission.mic.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck needs microphone access"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 需要麦克风权限"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
