    },
    "thread.outputs.review.installer.what.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Files like this are meant to configure, install, or run something rather than to be read. A profile or certificate changes settings like Wi-Fi, VPN and trust; an installer or program puts software on a machine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此类文件用于配置、安装或运行内容，而非阅读。描述文件或证书会更改 Wi-Fi、VPN 和信任等设置，安装程序或应用程序会在机器上安装软件。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos archivos sirven para configurar, instalar o ejecutar algo en lugar de leerlo. Un perfil o certificado cambia ajustes como Wi-Fi, VPN y confianza; un instalador o programa añade software a una máquina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この種類のファイルは読むためではなく、設定、インストール、実行を行うものです。プロファイルや証明書はWi-Fi、VPN、信頼などの設定を変更し、インストーラーやプログラムはマシンにソフトウェアを追加します。"
          }
        }
      }
    },
    "thread.outputs.review.installer.when.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saving it changes nothing. Opening it later — here, or wherever you move it — is the step that does."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存不会更改任何内容。之后在此处或其他位置打开，才会执行更改。"
