      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most file servers prove who they are with a certificate your device already trusts, and you can leave this empty. If yours uses its own certificate instead, Conduck can remember that certificate's fingerprint — a short unique code — so it only ever hands your files to the real server, never to an impostor pretending to be it. A setup code fills this in for you; otherwise paste it from your file server."
          }
        }
      }
    },
    "fileTransfer.tip.fingerprint.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
