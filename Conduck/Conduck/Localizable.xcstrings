    "settings.remoteAgent.auth.keyless.helper" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keyless — no token sent. Use only on a private network (Tailscale/LAN); HTTPS encrypts traffic but doesn't limit who can reach your gateway."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免密钥，不发送令牌。仅适用于私有网络（Tailscale/LAN）；HTTPS 会加密流量，但不会限制谁能访问网关。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin clave: no se envía ningún token. Úsalo solo en una red privada (Tailscale/LAN); HTTPS cifra el tráfico, pero no limita quién puede acceder a tu pasarela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーなし — 認証トークンは送信しません。非公開ネットワーク（Tailscale/LAN）でのみ使ってください。HTTPSは通信を暗号化しますが、ゲートウェイへの接続者を制限しません。"
          }
        }
      }
    },
    "settings.remoteAgent.auth.requiresToken.helper" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off only for a keyless gateway on a private network (Tailscale/LAN)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在私有网络（Tailscale/LAN）中的免密钥网关上关闭。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo solo para una pasarela sin clave en una red privada (Tailscale/LAN)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非公開ネットワーク（Tailscale/LAN）上のキー不要のゲートウェイの場合のみ無効にしてください。"
          }
        }
      }
    },
