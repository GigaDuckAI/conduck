    "settings.contentSync.explanation.off" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic content sync is turned off across your devices as they receive this change. Content already on each device and in iCloud is kept. Settings and keys continue to sync when available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各设备收到此更改后，自动内容同步会关闭。设备和 iCloud 中已有内容保留，设置和密钥在可用时继续同步。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización automática de contenido se desactiva en tus dispositivos a medida que reciben este cambio. El contenido que ya está en cada dispositivo y en iCloud se conserva. Los ajustes y las claves siguen sincronizándose cuando es posible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各デバイスがこの変更を受信すると、コンテンツの自動同期が無効になります。各デバイスとiCloudの既存コンテンツは保持されます。設定とキーは可能な場合に引き続き同期します。"
          }
        }
      }
    },
    "settings.contentSync.explanation.on" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversations, Work, files and usage records sync across your devices. This choice applies across your devices. Settings and keys continue to sync when available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话、工作台、文件和用量记录在各设备间同步，此选择适用于所有设备。设置和密钥在可用时继续同步。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversaciones, Trabajo, los archivos y los registros de uso se sincronizan entre tus dispositivos. Esta elección se aplica a todos ellos. Los ajustes y las claves siguen sincronizándose cuando es posible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話、ワークスペース、ファイル、利用記録をデバイス間で同期します。この選択はすべてのデバイスに適用されます。設定とキーは可能な場合に引き続き同期します。"
          }
        }
      }
    },
