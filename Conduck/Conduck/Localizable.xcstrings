    "settings.remoteAgent.tip.requiresToken.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave this on unless your gateway is deliberately set up without a password. Off means Conduck sends no password at all — anyone who can reach the address can use your AI. That's only safe on a private network like Tailscale or your own LAN."
          }
        }
      }
    },
    "settings.remoteAgent.tip.requiresToken.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires a bearer token"
