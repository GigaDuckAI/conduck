        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New chats on this device start here, but nothing for this gateway is stored on it. If you set it up on another device, iCloud may still be syncing — otherwise, fill it in below."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备的新对话使用此网关，但此设备没有存储它的设置。如果在其他设备完成设置，iCloud 可能仍在同步；否则请在下方填写。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats nuevos de este dispositivo empiezan aquí, pero no hay datos de esta pasarela guardados en él. Si la configuraste en otro dispositivo, puede que iCloud aún esté sincronizando; si no, completa los datos abajo."
          }
