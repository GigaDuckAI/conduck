      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The https:// address your server is reachable at from this device — a Tailscale name, a domain, or a LAN address. Paste just the base address; Conduck adds /v1/… itself."
          }
        }
      }
    },
    "settings.remoteAgent.customHelp.api.url.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
