      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ranked by input plus output tokens, added up from what your gateway reported — it reported no totals of its own. Threads reporting neither aren't ranked here."
