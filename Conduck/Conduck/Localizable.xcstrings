    "thread.outputs.review.macro.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These file endings mark Word, Excel and PowerPoint files that are allowed to hold macros — small programs saved inside the file itself. The ending says a macro is allowed, not that there is one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些扩展名表示允许包含宏的 Word、Excel 和 PowerPoint 文件。宏是保存在文件内部的小型程序。扩展名只表示允许宏，不代表确实包含宏。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas extensiones identifican archivos de Word, Excel y PowerPoint que pueden contener macros: pequeños programas guardados dentro del propio archivo. La extensión indica que se permite una macro, no que haya una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの拡張子は、ファイル内に小さなプログラムであるマクロを保存できるWord、Excel、PowerPointファイルを示します。マクロを許可する形式という意味で、実際に含まれているとは限りません。"
          }
        }
      }
    },
    "thread.outputs.review.macro.when" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saving it changes nothing. Opening it in an app that runs macros — Word, Excel or PowerPoint — is the step that can run one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存不会更改任何内容。在 Word、Excel 或 PowerPoint 等支持宏的 App 中打开，才可能运行宏。"
          }
        },
        "es" : {
