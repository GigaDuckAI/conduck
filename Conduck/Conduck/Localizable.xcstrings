      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test Connection checks that Conduck can reach this address, authenticate, and read its model list. To exercise the chat wire too, download the script on that machine with %@ and run bash conduck-connect.sh --check-server. After a PASS, the interactive script can continue into setup."
          }
