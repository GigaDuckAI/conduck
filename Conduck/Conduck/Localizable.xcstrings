    "settings.remoteAgent.forgetAlert.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck will erase the saved URL, token, and pin, plus any file-transfer setup for this gateway (server address and generated password). The URL and token are removed from all your devices signed in to iCloud; the pin is only on this one. You'll re-enter them next time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 将清除已保存的 URL、令牌和固定指纹，以及此网关的文件传输设置（服务器地址和生成的密码）。URL 和令牌会从所有登录 iCloud 的设备移除，固定指纹仅存于此设备。下次需要重新输入。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck borrará la URL guardada, el token y la huella fijada, además de la configuración de transferencia de archivos de esta pasarela (dirección del servidor y contraseña generada). La URL y el token se eliminan de todos tus dispositivos con sesión iniciada en iCloud; la huella fijada solo está en este. Tendrás que volver a introducirlos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したURL、認証トークン、固定したフィンガープリント、およびこのゲートウェイのファイル転送設定（サーバーアドレスと生成したパスワード）を削除します。URLと認証トークンはiCloudにサインインしたすべてのデバイスから削除され、フィンガープリントはこのデバイスからのみ削除されます。次回は再入力が必要です。"
          }
        }
      }
    },
    "settings.remoteAgent.forgetAlert.message.custom.retained.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck will delete this gateway and its saved URL, key, and pin, plus any file-transfer setup for it (server address and generated password). The URL and key are removed from all your devices signed in to iCloud; the pin is only on this one. Conversations bound to it stay readable but can't send new turns. They keep this gateway's colour tag so you can still tell them apart; its name is not kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 将删除此网关及其已保存的 URL、密钥、固定指纹和文件传输设置（服务器地址和生成的密码）。URL 和密钥会从所有登录 iCloud 的设备移除，固定指纹仅存于此设备。绑定的对话仍可阅读，但无法发送新消息。对话保留此网关的颜色标记以便区分，不保留名称。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck eliminará esta pasarela y su URL, clave y huella fijada guardadas, además de su configuración de transferencia de archivos (dirección del servidor y contraseña generada). La URL y la clave se eliminan de todos tus dispositivos con sesión iniciada en iCloud; la huella fijada solo está en este. Las conversaciones vinculadas seguirán siendo legibles, pero no podrán enviar nuevos turnos. Conservarán el color de esta pasarela para que puedas distinguirlas; su nombre no se conserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲートウェイと、保存したURL、キー、固定したフィンガープリント、およびファイル転送設定（サーバーアドレスと生成したパスワード）を削除します。URLとキーはiCloudにサインインしたすべてのデバイスから削除され、フィンガープリントはこのデバイスからのみ削除されます。関連付けられた会話は読めますが、新しいメッセージを送れません。区別できるように色は保持しますが、名前は保持しません。"
          }
        }
      }
    },
    "settings.remoteAgent.forgetAlert.message.hosted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck will erase the saved API key. It's removed from all your devices signed in to iCloud, not just this one. You'll re-enter it next time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 将清除已保存的 API 密钥。它会从所有登录 iCloud 的设备移除，而非仅此设备。下次需要重新输入。"
          }
