    "markdownLink.confirm.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This isn't a web link — it asks another app on your device to handle:\n\n%@\n\nThe link's text was written by your AI and can say anything, so open it only if you expected this."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是网页链接，它会请求设备上的另一个 App 处理：\n\n%@\n\n链接文字由 AI 撰写，可能与实际操作无关。只有符合你的预期时才打开。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no es un enlace web: pide a otra app de tu dispositivo que gestione:\n\n%@\n\nTu IA escribió el texto del enlace y puede decir cualquier cosa, así que ábrelo solo si lo esperabas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはWebリンクではありません。デバイス上の別のアプリで次の内容を処理します：\n\n%@\n\nリンクの表示テキストはAIが書いており、任意の内容を表示できます。想定した操作の場合のみ開いてください。"
          }
        }
      }
    },
