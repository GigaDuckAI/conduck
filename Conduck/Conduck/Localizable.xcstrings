    "settings.endpoint.pin.plainHTTP" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saved fingerprint can't be checked on an http:// address — nothing hands over a certificate. Clear the fingerprint, or use an https:// address."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http:// 地址不会提供证书，无法核验已保存的指纹。请清除指纹，或使用 https:// 地址。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una huella guardada no se puede comprobar en una dirección http://: no se presenta ningún certificado. Borra la huella o usa una dirección https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "http://アドレスでは証明書が提示されないため、保存したフィンガープリントを確認できません。フィンガープリントを削除するか、https://アドレスを使ってください。"
          }
        }
      }
    },
    "settings.endpoint.plainHTTP.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted — anyone else on this network can read your messages and the key sent with them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未加密，同一网络上的其他人可以读取消息及随附的密钥。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cifrar: cualquier otra persona en esta red puede leer tus mensajes y la clave enviada con ellos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されていません。このネットワーク上のほかの人が、メッセージや一緒に送信するキーを読み取れます。"
          }
        }
      }
    },
    "settings.endpoint.plainHTTP.warning.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted — anyone on this network can read your messages and your key. Works only on this network — not in the car or out with the Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未加密，同一网络上的任何人可以读取消息和密钥。仅限此网络内使用，无法在车内或携带 Apple Watch 外出时使用。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cifrar: cualquiera en esta red puede leer tus mensajes y tu clave. Solo funciona en esta red, no en el coche ni fuera de ella con el Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されていません。このネットワーク上の人がメッセージやキーを読み取れます。このネットワーク内でのみ動作し、車内や外出先のWatchでは使えません。"
          }
        }
      }
    },
    "settings.endpoint.url.plainHTTPRemote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS only allows plain http:// to an address on your own network. Use the server's IP address instead, or put it behind https://."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 仅允许对本地网络地址使用普通 http://。请改用服务器 IP 地址，或通过 https:// 提供服务。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS solo permite http:// sin cifrar en una dirección de tu propia red. Usa la dirección IP del servidor o ponlo detrás de https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSでは、暗号化されていないhttp://は自分のネットワーク内のアドレスにのみ使えます。サーバーのIPアドレスを使うか、https://で接続できるように設定してください。"
          }
        }
      }
    },
    "settings.endpoint.url.plainHTTPRemote.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple allows plain http:// only to an address on your own network. Use the server's IP address or its name ending in .local, or put it behind https://."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 仅允许对本地网络地址使用普通 http://。请使用服务器 IP 地址或以 .local 结尾的名称，或通过 https:// 提供服务。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple solo permite http:// sin cifrar en una dirección de tu propia red. Usa la dirección IP del servidor o su nombre terminado en .local, o ponlo detrás de https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでは、暗号化されていないhttp://は自分のネットワーク内のアドレスにのみ使えます。サーバーのIPアドレスか.localで終わる名前を使うか、https://で接続できるように設定してください。"
          }
        }
      }
    },
