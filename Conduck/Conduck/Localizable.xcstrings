    "settings.remoteAgent.fingerprint.helper" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave empty for default system trust. To pin: openssl x509 -pubkey -in cert.pem | openssl pkey -pubin -outform DER | shasum -a 256"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空以使用默认系统信任验证。固定指纹命令：openssl x509 -pubkey -in cert.pem | openssl pkey -pubin -outform DER | shasum -a 256"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para usar la confianza predeterminada del sistema. Para fijar la huella: openssl x509 -pubkey -in cert.pem | openssl pkey -pubin -outform DER | shasum -a 256"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のシステムによる信頼確認を使うには空欄にします。固定するには：openssl x509 -pubkey -in cert.pem | openssl pkey -pubin -outform DER | shasum -a 256"
          }
        }
      }
    },
    "settings.remoteAgent.fingerprint.helperShort.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Conduck already refuses any certificate this device doesn't trust; a fingerprint narrows that to one exact certificate. Leave it empty unless you have a reason."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。Conduck 已拒绝此设备不信任的证书，指纹会进一步限定为一个确切证书。除非有明确需要，否则请留空。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Conduck ya rechaza cualquier certificado en el que este dispositivo no confíe; una huella limita la aceptación a un certificado exacto. Déjalo vacío salvo que tengas un motivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意です。Conduckは、このデバイスが信頼しない証明書をすでに拒否します。フィンガープリントを指定すると、特定の証明書だけに限定されます。必要がなければ空欄にしてください。"
          }
        }
      }
    },
    "settings.remoteAgent.fingerprint.invalid" : {
      "extractionState" : "manual",
      "localizations" : {
