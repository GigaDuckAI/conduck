    "settings.remoteAgent.customCheck.body.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the server, download the script: %@. Then run bash conduck-connect.sh --check-server — or --check-adapter if this is an adapter built for Conduck. It only sends test requests; nothing on the server changes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在服务器上下载脚本：%@。然后运行 bash conduck-connect.sh --check-server；如果是为 Conduck 构建的适配器，则使用 --check-adapter。它仅发送测试请求，不会更改服务器。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el servidor, descarga el script: %@. Después ejecuta bash conduck-connect.sh --check-server, o --check-adapter si es un adaptador creado para Conduck. Solo envía solicitudes de prueba; no cambia nada en el servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーでスクリプトをダウンロードしてください：%@。続いてbash conduck-connect.sh --check-serverを実行します。Conduck用のアダプターなら--check-adapterを使います。テストリクエストを送るだけで、サーバーは変更しません。"
          }
        }
      }
    },
