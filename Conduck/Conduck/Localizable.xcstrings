    "settings.pairing.error.insecureURL.v2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS only allows plain http:// to an address on your own network. Re-run conduck-connect with the server's IP address, or put it behind https://."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 仅允许对本地网络地址使用普通 http://。请使用服务器 IP 地址重新运行 conduck-connect，或通过 https:// 提供服务。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS solo permite http:// sin cifrar en una dirección de tu propia red. Vuelve a ejecutar conduck-connect con la dirección IP del servidor o ponlo detrás de https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSでは、暗号化されていないhttp://は自分のネットワーク内のアドレスにのみ使えます。サーバーのIPアドレスでconduck-connectを再実行するか、https://で接続できるように設定してください。"
          }
        }
      }
    },
    "settings.pairing.error.insecureURL.v3" : {
