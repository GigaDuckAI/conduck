    "settings.stt.custom.url.userinfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take the username and password out of the address. Conduck won't keep a password inside a URL — that address syncs between your devices as plain text. Your endpoint's key goes in the API key field."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从地址中移除用户名和密码。Conduck 不会将密码保存在 URL 中，因为地址会以纯文本在设备间同步。端点密钥应填写在“API 密钥”字段。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita el nombre de usuario y la contraseña de la dirección. Conduck no guardará una contraseña dentro de una URL: esa dirección se sincroniza entre tus dispositivos como texto plano. La clave de tu punto de conexión va en el campo Clave de API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスからユーザー名とパスワードを削除してください。アドレスはデバイス間で平文として同期されるため、ConduckはURL内にパスワードを保存しません。エンドポイントのキーは「APIキー」欄に入力してください。"
          }
        }
      }
    },
