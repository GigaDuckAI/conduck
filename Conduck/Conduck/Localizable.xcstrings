    "gatewaySetup.helperTrust.safe.confident" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open source and local — it runs only on your computer, asks before every change it makes, and sends us nothing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开源且本地运行，仅在你的电脑上执行，每次更改前都会询问，不向我们发送任何内容。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código abierto y local: solo se ejecuta en tu ordenador, pide permiso antes de cada cambio y no nos envía nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オープンソースで、あなたのコンピュータ上でのみ動作します。変更前に毎回確認し、私たちには何も送信しません。"
          }
        }
      }
    },
