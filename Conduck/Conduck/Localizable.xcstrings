    "settings.remoteAgent.url.temporaryTunnelHint" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is a temporary tunnel address. It normally changes when the tunnel restarts, and this gateway then stops working until you set it up again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是临时隧道地址，通常在隧道重启后改变。此后网关将无法使用，直到重新设置。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es una dirección de túnel temporal. Suele cambiar al reiniciar el túnel y la pasarela deja de funcionar hasta que vuelvas a configurarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時的なトンネルのアドレスです。通常はトンネルの再起動で変わり、再設定するまでこのゲートウェイは使えなくなります。"
          }
        }
      }
    },
    "settings.remoteAgent.url.userinfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take the username and password out of the address. Conduck won't keep a password inside a URL — that address syncs between your devices as plain text. Your gateway's token goes in the Token field."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从地址中移除用户名和密码。Conduck 不会将密码保存在 URL 中，因为地址会以纯文本在设备间同步。网关令牌应填写在“令牌”字段。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita el nombre de usuario y la contraseña de la dirección. Conduck no guardará una contraseña dentro de una URL: esa dirección se sincroniza entre tus dispositivos como texto plano. El token de tu pasarela va en el campo Token."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスからユーザー名とパスワードを削除してください。アドレスはデバイス間で平文として同期されるため、ConduckはURL内にパスワードを保存しません。ゲートウェイの認証トークンは「認証トークン」欄に入力してください。"
          }
        }
      }
    },
