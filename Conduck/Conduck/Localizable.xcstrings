        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To change a shortcut, click it and press the keys together — one or more modifiers (⌘ ⌥ ⌃ ⇧) plus one regular key. Esc always cancels the request."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要更改快捷键，请点按它并同时按下所需按键：一个或多个修饰键（⌘ ⌥ ⌃ ⇧）加一个普通键。Esc 始终用于取消请求。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cambiar una función rápida, haz clic en ella y pulsa las teclas a la vez: uno o más modificadores (⌘ ⌥ ⌃ ⇧) y una tecla normal. Esc siempre cancela la solicitud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを変更するには、クリックして、修飾キー（⌘ ⌥ ⌃ ⇧）を1つ以上と通常のキー1つを同時に押してください。Escは常にリクエストをキャンセルします。"
          }
        }
      }
    },
