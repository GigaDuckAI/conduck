    "settings.remoteAgent.customHelp.api.token.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever password that address checks before answering — set in your framework's config, or by a proxy in front of it. If your server deliberately has no password on a private network, turn off “Requires a bearer token” instead."
          }
        }
      }
    },
    "settings.remoteAgent.customHelp.api.token.label" : {
      "extractionState" : "manual",
      "localizations" : {
