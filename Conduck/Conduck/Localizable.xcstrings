    "fileTransfer.status.uploadOnly.meaning" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck uploaded a test file and read it back. This server can't list folders, so files the agent creates won't come back on their own — you'll still find them on the server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 已上传测试文件并读回。此服务器无法列出文件夹，因此智能体创建的文件不会自动返回，你仍可在服务器上找到它们。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck subió un archivo de prueba y lo leyó. Este servidor no puede listar carpetas, así que los archivos que cree el agente no volverán automáticamente; seguirás encontrándolos en el servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduckがテストファイルをアップロードし、読み取れました。このサーバーはフォルダ一覧を取得できないため、エージェントが作成したファイルは自動で返却されません。サーバー上では確認できます。"
          }
        }
