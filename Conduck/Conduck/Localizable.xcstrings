        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按网关报告的输入和输出 Token 相加排序，因为它未自行报告总量。两者均未报告的对话不参与排名。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenados por tokens de entrada más salida, sumados a partir de los datos de tu pasarela: no informó de sus propios totales. Los hilos que no informan de ninguno no se clasifican aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
