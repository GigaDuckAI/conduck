          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已记录 %lld 次同步事件，上次尝试失败。这些历史记录不能说明当前同步状况。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld eventos de sincronización registrados; el último intento registrado falló. Este historial no confirma el estado actual de la sincronización."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の同期イベントが記録されており、前回の記録された試行は失敗しました。この履歴から現在の同期状態は判断できません。"
          }
        }
      }
    },
