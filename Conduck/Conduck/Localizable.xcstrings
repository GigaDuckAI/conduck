    "settings.contentSync.enable.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content created or changed on any of your devices while sync was off will sync with the current iCloud account, including edits and deletions. Content already in iCloud will become available again as your devices receive this change."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步关闭期间在任何设备上创建或更改的内容，将与当前 iCloud 账户同步，包括编辑和删除。各设备收到此更改后，iCloud 中已有内容将再次可用。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido creado o modificado en cualquiera de tus dispositivos mientras la sincronización estaba desactivada se sincronizará con la cuenta actual de iCloud, incluidos los cambios y las eliminaciones. El contenido que ya está en iCloud volverá a estar disponible a medida que tus dispositivos reciban este cambio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期が無効の間に各デバイスで作成・変更したコンテンツは、編集や削除も含め、現在のiCloudアカウントに同期されます。デバイスがこの変更を受信すると、iCloudの既存コンテンツも再び利用できるようになります。"
          }
        }
      }
    },
    "settings.contentSync.enable.title" : {
