    "settings.voice.readAloud.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replies to Shortcut captures (Action Button or Control Center) speak when you open them on this iPhone. Questions you ask on Apple Watch are spoken there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过快捷指令采集内容（操作按钮或控制中心）后，在此 iPhone 打开回复时会朗读。Apple Watch 上提问的回复在手表上朗读。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas a capturas con atajos (botón de acción o centro de control) se leen cuando las abres en este iPhone. Las preguntas que haces en Apple Watch se leen allí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクションボタンやコントロールセンターのショートカットで取り込んだ内容への返信は、このiPhoneで開くと読み上げます。Apple Watchからの質問はWatchで読み上げます。"
          }
        }
      }
    },
