    "settings.usage.counting.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A turn is one message; a retry adds another attempt. Shares include all recorded attempts. Success rates use succeeded and failed attempts. Reply times cover successful replies. Token reporting may be incomplete and is not a bill. Removing gateways or conversations keeps their usage history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一轮指一条消息，重试会增加一次尝试。占比包含全部已记录的尝试。成功率仅统计成功和失败的尝试，回复时间仅统计成功回复。Token 报告可能不完整，不代表账单。移除网关或对话后，用量历史仍保留。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un turno es un mensaje; reintentar añade otro intento. Las proporciones incluyen todos los intentos registrados. Las tasas de éxito usan intentos exitosos y fallidos. Los tiempos de respuesta cubren respuestas exitosas. Los datos de tokens pueden estar incompletos y no son una factura. Eliminar pasarelas o conversaciones conserva su historial de uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1ターンは1メッセージで、再試行は試行回数を増やします。割合には記録されたすべての試行を含み、成功率は成功と失敗の試行から計算します。返信時間は成功した返信が対象です。トークン報告は不完全な場合があり、請求額ではありません。ゲートウェイや会話を削除しても利用履歴は残ります。"
          }
        }
      }
    },
