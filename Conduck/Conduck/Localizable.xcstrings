    "settings.voice.apple.voice.unavailable.ios" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This voice didn't play. Download it again in Settings → Accessibility → Read & Speak → Voices, then tap it here to try again, or pick another. Replies use the system voice until then."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此声音无法播放。请在“设置”→“辅助功能”→“阅读与朗读”→“声音”中重新下载，然后在此轻点重试，或选择其他声音。此期间回复将使用系统声音。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta voz no se reprodujo. Vuelve a descargarla en Ajustes → Accesibilidad → Lectura y voz → Voces y tócala aquí para reintentar, o elige otra. Hasta entonces, las respuestas usarán la voz del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この音声を再生できませんでした。設定 → アクセシビリティ → リーダーと読み上げ → 声で再ダウンロードし、ここでタップして再試行するか、別の音声を選んでください。それまではシステム音声で返信を読み上げます。"
          }
        }
      }
    },
    "settings.voice.apple.voice.unavailable.mac" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This voice didn't play. Download it again in System Settings → Accessibility → Read & Speak (the info button next to System Voice), then click it here to try again, or pick another. Replies use the system voice until then."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此声音无法播放。请在“系统设置”→“无障碍/辅助功能”→“阅读与朗读”中，使用“系统声音”旁的信息按钮重新下载，然后在此点按重试，或选择其他声音。此期间回复将使用系统声音。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta voz no se reprodujo. Vuelve a descargarla en Ajustes del Sistema → Accesibilidad → Lectura y voz (el botón de información junto a Voz del sistema) y haz clic aquí para reintentar, o elige otra. Hasta entonces, las respuestas usarán la voz del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この音声を再生できませんでした。システム設定 → アクセシビリティ → リーダーと読み上げで、システムの声の横にある情報ボタンから再ダウンロードし、ここでクリックして再試行するか、別の音声を選んでください。それまではシステム音声で返信を読み上げます。"
          }
        }
      }
    },
