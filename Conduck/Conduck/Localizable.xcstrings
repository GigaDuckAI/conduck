    "settings.remoteAgent.tip.url.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The web address of the server you run — the machine your AI actually lives on. Conduck sends your messages there and nowhere else. It must start with https, and it must be reachable from this device: a Tailscale address works anywhere this device runs Tailscale; a home-network address only at home."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是你运行的服务器的网络地址，即 AI 所在的机器。Conduck 只向那里发送消息。地址必须以 https 开头且此设备能够访问：此设备运行 Tailscale 时，Tailscale 地址可在任何地方使用；家庭网络地址仅能在家使用。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección web del servidor que gestionas, la máquina donde está realmente tu IA. Conduck envía tus mensajes únicamente allí. Debe empezar por https y ser accesible desde este dispositivo: una dirección de Tailscale funciona donde este dispositivo ejecute Tailscale; una dirección de la red doméstica, solo en casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIが実際に稼働する、自分のサーバーのWebアドレスです。Conduckはここだけにメッセージを送信します。httpsで始まり、このデバイスから接続できる必要があります。TailscaleアドレスはこのデバイスでTailscaleを使う場所なら接続でき、自宅ネットワークのアドレスは自宅でのみ接続できます。"
          }
        }
      }
    },
