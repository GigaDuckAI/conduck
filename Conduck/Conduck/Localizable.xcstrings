    "workboard.voice.privacy" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your recording stays on this device while it becomes words, and the words go to your private desk. The audio goes only to the speech provider you chose, and only to be turned into words — never into a conversation, and never through a server of ours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音转成文字期间保留在此设备上，文字将进入私人工作台。音频仅发送给你所选的语音服务商，只用于转写，不会进入对话，也不会经过我们的服务器。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu grabación permanece en este dispositivo mientras se convierte en texto y el texto va a tu escritorio privado. El audio solo va al proveedor de voz que elegiste y solo para convertirse en texto: nunca a una conversación ni a través de un servidor nuestro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音は文字起こしの間このデバイスに保持され、テキストは非公開のワークスペースに保存されます。音声は選んだ音声認識プロバイダーに、文字起こしのためだけに送信されます。会話には含まれず、私たちのサーバーを通ることもありません。"
          }
        }
      }
    },
