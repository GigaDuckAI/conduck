    "workdesk.tour.capture.mac.brief" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click the menu-bar duck and choose Capture to Work. Save a screenshot, a thought, or both."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按菜单栏的鸭子，选择“采集到工作台”。可以保存截屏、想法，或两者一起保存。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en el pato de la barra de menús y elige Capturar en Trabajo. Guarda una captura de pantalla, una idea o ambas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーのアヒルを右クリックして「ワークスペースに取り込む」を選びます。スクリーンショット、考え、または両方を保存できます。"
          }
        }
      }
    },
