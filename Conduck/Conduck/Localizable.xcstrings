          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是网关响应前核验的密码，确保只有你的设备能访问 AI。Conduck 将它保存在钥匙串中，且仅发送给网关。"
          }
        },
        "es" : {
          "stringUnit" : {
