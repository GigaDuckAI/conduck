    "gateway.credentialSource.hermes.caveat.apiServer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes's setup wizard does NOT turn its API server on. Set API_SERVER_ENABLED=true in the same file, then restart Hermes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 的设置向导不会开启 API 服务器。请在同一文件中设置 API_SERVER_ENABLED=true，然后重启 Hermes。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente de configuración de Hermes NO activa su servidor API. Define API_SERVER_ENABLED=true en el mismo archivo y reinicia Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesの設定ウィザードではAPIサーバーは有効になりません。同じファイルにAPI_SERVER_ENABLED=trueを設定し、Hermesを再起動してください。"
          }
        }
      }
    },
    "gateway.credentialSource.hermes.healthBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To check the server is alive at all, open this route in a browser. If this route doesn't answer, the API server itself is off — see the note below:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要检查服务器是否正在运行，请在浏览器中打开此路由。如果没有响应，说明 API 服务器本身未开启，请参阅下方说明："
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comprobar si el servidor responde, abre esta ruta en un navegador. Si no responde, el propio servidor API está desactivado; consulta la nota de abajo:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー自体が稼働しているか確認するには、このルートをブラウザで開いてください。応答がなければAPIサーバー自体が無効です。下の注記を確認してください："
          }
        }
      }
    },
    "gateway.credentialSource.hermes.tokenBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes does not generate a token — you choose it yourself. Open this file on your server and copy the value stored under this key; if the key isn't there, add it with a long random value of your own and restart Hermes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 不会生成令牌，需要你自己设定。在服务器上打开此文件，复制此键对应的值；如果此键不存在，请添加自己生成的较长随机值，然后重启 Hermes。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no genera un token: lo eliges tú. Abre este archivo en tu servidor y copia el valor guardado en esta clave; si no existe, añádela con un valor largo y aleatorio y reinicia Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesは認証トークンを生成しません。自分で決めてください。サーバー上のこのファイルを開き、このキーに保存された値をコピーします。キーがなければ、長いランダムな値を設定してHermesを再起動してください。"
          }
        }
      }
    },
    "gateway.credentialSource.openclaw.caveat.envSeed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't copy the token from the Docker .env file — that value is only a setup seed and can drift. Use gateway.auth.token in openclaw.json."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要复制 Docker .env 文件中的令牌，该值只是初始化设置时使用，之后可能不同。请使用 openclaw.json 中的 gateway.auth.token。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No copies el token del archivo .env de Docker: ese valor es solo un valor inicial de configuración y puede quedar desactualizado. Usa gateway.auth.token en openclaw.json."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockerの.envファイルから認証トークンをコピーしないでください。その値は初期設定用で、実際の値と異なることがあります。openclaw.jsonのgateway.auth.tokenを使ってください。"
          }
        }
      }
    },
    "gateway.credentialSource.openclaw.healthBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To check the server is alive at all, open this route in a browser — it answers even when the AI endpoint is switched off:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要检查服务器是否正在运行，请在浏览器中打开此路由。即使 AI 端点关闭，它也会响应："
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comprobar si el servidor responde, abre esta ruta en un navegador: responde incluso con el punto de conexión de IA desactivado:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー自体が稼働しているか確認するには、このルートをブラウザで開いてください。AIエンドポイントが無効でも応答します："
          }
        }
      }
    },
    "gateway.credentialSource.openclaw.tokenBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClaw generated a token for you when you installed it — you don't have to invent one. Open this file on your server and copy the value stored under this key — the real secret, and if it shows a ${…} placeholder, paste the value it points to, not the placeholder:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 OpenClaw 时已为你生成令牌，无需自己设定。在服务器上打开此文件，复制此键对应的真实密钥；如果显示 ${…} 占位符，请粘贴它引用的值，而非占位符："
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClaw generó un token al instalarlo: no tienes que inventar uno. Abre este archivo en tu servidor y copia el valor guardado en esta clave, el secreto real; si muestra un marcador ${…}, pega el valor al que apunta, no el marcador:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClawはインストール時に認証トークンを生成するため、自分で作る必要はありません。サーバー上のこのファイルを開き、このキーに保存された実際の秘密の値をコピーしてください。${…}のプレースホルダーがある場合は、プレースホルダーではなく、それが参照する値を貼り付けてください："
          }
        }
      }
    },
