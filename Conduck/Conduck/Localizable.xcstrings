    "thread.gatewayLock.body" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This chat stays on %@ to keep context consistent. To use another gateway, clone it — the original stays here unchanged, and your history reaches the new gateway only when you continue there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此对话保持使用 %@，确保上下文一致。要使用另一网关，请复制对话。原对话保持不变，仅在新网关继续时才会将历史发送给它。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat permanece en %@ para mantener el contexto coherente. Para usar otra pasarela, clónalo: el original queda aquí sin cambios y tu historial solo llega a la nueva pasarela cuando continúas allí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話の文脈を保つため、このチャットは%@を使い続けます。別のゲートウェイを使うには複製してください。元の会話はそのまま残り、新しいゲートウェイで続けたときに初めて履歴が送られます。"
          }
        }
      }
    },
