    "gatewaySetup.readiness.tip.server.a11y" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About running as a server"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于以服务器形式运行"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de funcionar como servidor"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーとしての稼働について"
          }
        }
      }
    },
    "gatewaySetup.readiness.tip.server.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A program that stays on and answers requests at a web address — not something you start, use, and close when you're done. It has to speak the OpenAI-compatible chat API, which is what most AI servers already use. Conduck only connects over https, and the setup step can put that in front of your server for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程序持续运行，并通过网络地址响应请求，而不是使用完就关闭。它必须支持兼容 OpenAI 的聊天 API，大多数 AI 服务器已经使用此接口。Conduck 仅通过 https 连接，设置步骤可为服务器配置此访问方式。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa que permanece encendido y responde a solicitudes en una dirección web, en lugar de algo que abres, usas y cierras al terminar. Debe usar la API de chat compatible con OpenAI, que es la que ya usa la mayoría de servidores de IA. Conduck solo conecta mediante https y el paso de configuración puede añadirlo delante de tu servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なときだけ起動して終了するアプリではなく、常時稼働してWebアドレスでリクエストに応答するプログラムです。多くのAIサーバーがすでに使うOpenAI互換のチャットAPIに対応する必要があります。Conduckはhttpsでのみ接続し、設定手順でサーバーの前にhttps接続を追加できます。"
          }
        }
      }
    },
