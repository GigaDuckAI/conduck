    "settings.usage.clear.message.contentSync" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes every usage record from this device and all your other devices, even when content sync is off. Your conversations are not affected. This cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从此设备及所有其他设备移除全部用量记录，即使内容同步已关闭。对话不受影响，此操作无法撤销。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los registros de uso de este dispositivo y de todos los demás, incluso con la sincronización de contenido desactivada. Tus conversaciones no se ven afectadas. No se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツ同期が無効でも、このデバイスとほかのすべてのデバイスから全利用記録を削除します。会話は影響を受けません。この操作は取り消せません。"
          }
        }
      }
    },
