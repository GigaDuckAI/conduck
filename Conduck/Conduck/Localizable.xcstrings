    "settings.watch.sync.footer" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Queues your current provider, key, and gateway settings for delivery. Delivery happens in the background, even when the Watch is out of reach — it completes the next time your Apple Watch is available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将当前服务商、密钥和网关设置加入待发送队列。发送在后台进行，即使 Apple Watch 暂时无法连接，也会在下次可用时完成。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone en espera los ajustes actuales de proveedor, clave y pasarela para enviarlos. La entrega ocurre en segundo plano, incluso cuando el Watch no está accesible; se completa la próxima vez que tu Apple Watch esté disponible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のプロバイダー、キー、ゲートウェイ設定を送信待ちにします。Watchに届かないときもバックグラウンドで処理し、次に接続できたときに送信を完了します。"
          }
        }
      }
    },
