    "fileTransfer.inline.uploadOnly" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sending files works. This server can't list folders, so files the agent creates won't come back on their own — you'll still find them on the server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件发送正常，但此服务器无法列出文件夹，因此智能体创建的文件不会自动返回。你仍可在服务器上找到它们。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío de archivos funciona. Este servidor no puede listar carpetas, así que los archivos que cree el agente no volverán automáticamente; seguirás encontrándolos en el servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの送信はできますが、このサーバーはフォルダ一覧を取得できないため、エージェントが作成したファイルは自動で返却されません。サーバー上では確認できます。"
          }
        }
      }
    },
    "fileTransfer.intro.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let your agent work on real files — PDFs, spreadsheets, archives. They live on a small file-server next to your agent; Conduck never stores them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体处理实际文件，例如 PDF、电子表格和压缩包。文件保存在智能体旁的小型文件服务器上，Conduck 从不存储它们。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que tu agente trabaje con archivos reales: PDF, hojas de cálculo y archivos comprimidos. Están en un pequeño servidor de archivos junto a tu agente; Conduck nunca los almacena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF、スプレッドシート、アーカイブなど、実際のファイルをエージェントで扱えます。ファイルはエージェントの隣にある小さなファイルサーバーに保存され、Conduckは保存しません。"
          }
        }
      }
    },
