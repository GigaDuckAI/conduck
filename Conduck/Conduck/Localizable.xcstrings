        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The web address of the server you run — the machine your AI actually lives on. Conduck sends your messages there and nowhere else. It must start with https, and it must be reachable from this device: a Tailscale address works anywhere this device runs Tailscale; a home-network address only at home."
          }
        }
      }
    },
