        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's still your default, and it'll work again on its own if it's just waiting on iCloud. To use a different gateway for new chats on this device, pick one below."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
