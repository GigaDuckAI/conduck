    "fileTransfer.tip.url.a11y" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About File-server URL"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于文件服务器 URL"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de URL del servidor de archivos"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルサーバーURLについて"
          }
        }
      }
    },
    "fileTransfer.tip.url.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your gateway carries the conversation, but it has nowhere to put a file. So files go to a second small service you run alongside it — a file server — and your agent picks them up from there. This is that service's address, which is why it's a different address and port from the gateway's. Conduck uploads straight to it; the file passes through no one else."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网关负责对话，但没有存放文件的地方。因此文件会传到你在旁边运行的另一个小型服务——文件服务器，智能体再从那里读取。这是该服务的地址，所以与网关的地址和端口不同。Conduck 直接上传到它，文件不会经过其他人。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pasarela lleva la conversación, pero no tiene dónde poner un archivo. Por eso los archivos van a otro pequeño servicio que ejecutas junto a ella, un servidor de archivos, y tu agente los recoge allí. Esta es la dirección de ese servicio, por eso usa una dirección y un puerto distintos de los de la pasarela. Conduck sube los archivos directamente; no pasan por nadie más."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイは会話を処理しますが、ファイルの置き場所はありません。ファイルは、ゲートウェイと一緒に運用する別の小さなサービスであるファイルサーバーに送られ、エージェントがそこから取得します。これはそのサービスのアドレスのため、ゲートウェイとはアドレスとポートが異なります。Conduckは直接アップロードし、ファイルはほかのサービスを通りません。"
          }
        }
      }
    },
    "fileTransfer.tip.url.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File-server URL"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件服务器 URL"
          }
        },
        "es" : {
