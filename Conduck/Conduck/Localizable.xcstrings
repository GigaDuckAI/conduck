    "settings.pairing.export.noLock.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck couldn't ask for Face ID, Touch ID, or a passcode, so anyone holding this device can reveal a code that grants full access to your gateway. Set a device passcode for real protection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 无法请求面容 ID、触控 ID 或密码验证，因此任何持有此设备的人都能显示具有网关完整访问权限的代码。请设置设备密码，以获得有效保护。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck no pudo solicitar Face ID, Touch ID ni un código de acceso, así que cualquiera que tenga este dispositivo puede mostrar un código que da acceso completo a tu pasarela. Configura un código de acceso en el dispositivo para protegerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID、Touch ID、パスコードによる確認ができないため、このデバイスを持つ人は誰でも、ゲートウェイへの完全なアクセスを許可するコードを表示できます。保護するにはデバイスのパスコードを設定してください。"
          }
        }
      }
    },
