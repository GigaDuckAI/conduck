    "settings.tts.custom.footer" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If a reply can't reach this provider, it's spoken with Apple's on-device voice. Apple Watch always uses the Apple voice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接此服务商时，回复会使用 Apple 设备端语音朗读。Apple Watch 始终使用 Apple 语音。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
