    "settings.usage.detail.turnBasis.components" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Largest turns are ranked by input plus output, added up from what your gateway reported — it reported no totals of its own."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用量最大的轮次按网关报告的输入和输出相加排序，因为它未自行报告总量。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los turnos de mayor tamaño se ordenan por entrada más salida, sumadas a partir de los datos de tu pasarela: no informó de sus propios totales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイの報告から入力と出力を合算して、使用量の多いターンを並べています。ゲートウェイから合計は報告されていません。"
          }
        }
      }
    },
