    "workdesk.material.used.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These conversations used a copy of the material as it was when sent. Moving or editing it in Work doesn’t change earlier messages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些对话使用的是发送时的素材副本。在工作台移动或编辑素材不会改变之前的消息。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas conversaciones usaron una copia del material tal como era al enviarlo. Moverlo o editarlo en Trabajo no cambia los mensajes anteriores."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの会話では、送信時点の素材のコピーを使っています。ワークスペースで移動・編集しても、過去のメッセージは変わりません。"
          }
        }
      }
    },
