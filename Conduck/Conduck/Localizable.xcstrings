    "settings.stt.provider.apple.deleteAlert.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iOS manages the on-device model. To remove it, open Settings, then go to General → iPhone Storage → Conduck."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 管理设备端模型。要移除模型，请打开“设置”→“通用”→“iPhone 储存空间”→“Conduck”。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS gestiona el modelo en el dispositivo. Para eliminarlo, abre Ajustes y ve a General → Almacenamiento del iPhone → Conduck."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス内モデルはiOSが管理します。削除するには、設定 → 一般 → iPhoneストレージ → Conduckを開いてください。"
          }
        }
      }
    },
    "settings.stt.provider.apple.deleteAlert.message.macos" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS manages the on-device speech model automatically and reclaims its space when needed. There's nothing to remove here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 自动管理设备端语音模型，在需要时回收空间。此处无需移除任何内容。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gestiona automáticamente el modelo de voz del dispositivo y recupera su espacio cuando lo necesita. No hay nada que eliminar aquí."
          }
