    "chat.defaultGateway.noDefault.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything that starts a chat from outside the app doesn't know which one to use. Pick one and new chats will start on it. New chats you start here are fine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 App 外发起对话的功能尚未确定使用哪个网关。选择一个后，新对话将使用它。在此处新建对话仍可正常使用。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que inicia un chat desde fuera de la app no sabe cuál usar. Elige una y los chats nuevos empezarán en ella. Los chats nuevos que inicies aquí funcionan bien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ外からチャットを始める場合、使用するゲートウェイが必要です。1つ選ぶと、新しいチャットはそれを使って始まります。ここで開始する新しいチャットは問題なく使えます。"
          }
        }
      }
    },
