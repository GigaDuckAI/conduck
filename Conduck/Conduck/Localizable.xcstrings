    "diagnostics.footer.copy" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copies a safe summary you can paste anywhere. No links, keys, or message content are included."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制可安全粘贴到任何地方的摘要，不包含链接、密钥或消息内容。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un resumen seguro que puedes pegar donde quieras. No incluye enlaces, claves ni contenido de mensajes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
