        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conduck will erase the saved URL, key, and pin, plus any file-transfer setup for this gateway (server address and generated password). The URL and key are removed from all your devices signed in to iCloud; the pin is only on this one. You'll re-enter them next time."
          }
        }
      }
    },
    "settings.remoteAgent.forgetAlert.message.hosted" : {
