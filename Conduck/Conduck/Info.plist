<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>$(CONDUCK_DISPLAY_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ConduckAppGroupID</key>
	<string>$(CONDUCK_GROUP_ID)</string>
	<key>ConduckCloudKitContainerID</key>
	<string>$(CONDUCK_ICLOUD_CONTAINER_ID)</string>
	<key>ConduckIdentityNamespace</key>
	<string>$(CONDUCK_IDENTITY_NAMESPACE)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSUIElement</key>
	<false/>
	<!-- ATS: NSAllowsLocalNetworking ONLY, and never NSAllowsArbitraryLoads.
	     Measured on iOS 26.5 (sim, build 23F77): shipping both keys yields the
	     RESTRICTIVE behaviour, not arbitrary loads — the local-networking key
	     SUPPRESSES the arbitrary-loads key, so http://example.com is refused
	     -1022 with both present but succeeds with arbitrary-loads alone. A
	     future engineer adding NSAllowsArbitraryLoads here would get nothing
	     and have no way to know why. It is also one of the five keys Apple
	     lists as requiring an App Review justification; this one is not.
	     Why ship a key that measured as a no-op: it is the documented
	     declaration that pairs with NSLocalNetworkUsageDescription, it makes
	     the RFC1918-literal exemption contractual rather than an OS default,
	     and it reads correctly to a reviewer who sees plain-http gateway URLs.
	     Full rationale + the measured matrix: Services/RemoteAgent/EndpointURLPolicy.swift -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Conduck uses the camera to attach a photo to your message.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Conduck uses Face ID to confirm it's you before revealing a gateway setup code, which grants full access to your gateway.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Conduck connects to the personal AI gateway or file server you run on your local network, when you configure one at a local address.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Conduck records audio for voice transcription using the speech provider you have configured, and to send messages to a personal AI assistant you've configured.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Conduck uses Apple's on-device speech recognition when you select Apple as your STT provider. Audio never leaves your device.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>Conduck CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
