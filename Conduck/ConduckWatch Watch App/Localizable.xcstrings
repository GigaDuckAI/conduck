    "settings.certTrust.untrusted.remedy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the server a publicly trusted certificate: Tailscale Serve issues one automatically, Let's Encrypt is free and also issues certificates for plain IP addresses, or put a domain in front with Caddy, which renews for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请为服务器配置受公众信任的证书：Tailscale Serve 会自动签发，免费的 Let's Encrypt 也支持为纯 IP 地址签发证书；或通过域名和 Caddy 提供服务，由 Caddy 自动续期。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna al servidor un certificado de confianza pública: Tailscale Serve emite uno automáticamente, Let's Encrypt es gratuito y también emite certificados para direcciones IP, o coloca un dominio delante con Caddy, que lo renueva por ti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに公的に信頼される証明書を設定してください。Tailscale Serveは自動発行します。無料のLet's EncryptはIPアドレス用の証明書にも対応しています。またはCaddyを使ってドメイン経由にすると、自動更新できます。"
          }
        }
      }
    },
