    "settings.certTrust.keyUnpinnable.refusal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server's certificate uses a key type Conduck can't fingerprint, so your pinned fingerprint can't be checked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器证书的密钥类型不支持生成指纹，Conduck 无法核验你固定的指纹。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado de este servidor usa un tipo de clave cuya huella Conduck no puede calcular, por lo que no se puede comprobar la huella fijada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーの証明書の鍵形式にConduckが対応していないため、固定したフィンガープリントを確認できません。"
          }
        }
      }
    },
    "settings.certTrust.keyUnpinnable.refusal.compact" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck can't check your pin — unsupported certificate key. Your server is fine; open Conduck on your iPhone to fix the pin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证书密钥类型不受支持，Conduck 无法核验固定指纹。服务器本身没有问题，请在 iPhone 上打开 Conduck 修正指纹设置。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck no puede comprobar tu huella fijada: la clave del certificado no es compatible. Tu servidor está bien; abre Conduck en tu iPhone para corregir la huella fijada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明書の鍵に対応していないため、Conduckは固定したフィンガープリントを確認できません。サーバーには問題ありません。iPhoneでConduckを開いて設定を修正してください。"
          }
        }
      }
    },
    "settings.certTrust.keyUnpinnable.remedy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate itself is fine and this device trusts it — only the fingerprint check can't run. Reissue it with an RSA 2048/3072/4096 or EC P-256/P-384 key, or clear the saved fingerprint in its settings to go back to ordinary system trust."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证书本身正常，且此设备信任它，只是无法核验指纹。请使用 RSA 2048/3072/4096 或 EC P-256/P-384 密钥重新签发证书，或在设置中清除已保存的指纹，恢复常规系统信任验证。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado está bien y este dispositivo confía en él; solo falla la comprobación de la huella. Vuelve a emitirlo con una clave RSA 2048/3072/4096 o EC P-256/P-384, o borra la huella guardada en sus ajustes para volver a la confianza normal del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明書自体は有効で、このデバイスも信頼していますが、フィンガープリントの確認だけが実行できません。RSA 2048/3072/4096またはEC P-256/P-384鍵で再発行するか、設定で保存したフィンガープリントを削除して通常のシステムによる信頼確認に戻してください。"
          }
        }
      }
    },
    "settings.certTrust.pinMismatch.refusal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
