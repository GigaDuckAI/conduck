{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck connects to the personal AI gateway you run on your local network, when you configure one at a local address."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置本地地址时，Conduck 会连接你在本地网络中运行的个人 AI 网关。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck conecta con la pasarela de IA personal que ejecutas en tu red local cuando configuras una con una dirección local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルアドレスを設定した場合、Conduckはローカルネットワークで運用するパーソナルAIのゲートウェイに接続します。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck records audio on your Watch for voice transcription using the speech provider you have configured."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck 在 Apple Watch 上录制音频，使用你配置的语音服务商进行转写。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduck graba audio en tu Watch para transcribir voz con el proveedor que has configurado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ConduckはWatchで音声を録音し、設定した音声認識プロバイダーで文字起こしします。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
